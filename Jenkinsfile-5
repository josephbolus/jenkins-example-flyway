pipeline {
  agent any
  environment {
    DB_CREDS       = credentials('db-creds')
    FLYWAY_IMAGE   = 'flyway/flyway:8.5.1'
    FLYWAY_NETWORK = 'sandbox-net'
    FLYWAY_CONFIG  = '/flyway/conf/flyway.conf'
  }
  stages {
    stage('Verify version') {
      steps {
        sh 'docker run --rm $FLYWAY_IMAGE version'
      }
    }
    stage('migrate') {
      steps {
        sh '''echo "$JENKINS_HOME_PATH/workspace/$JOB_NAME/sql:/flyway/sql" && ls $JENKINS_HOME_PATH/workspace/$JOB_NAME/sql:/flyway/sql && docker run --rm \
          --network $FLYWAY_NETWORK \
          -v $JENKINS_HOME_PATH/workspace/$JOB_NAME/sql:/flyway/sql \
          -v $JENKINS_HOME_PATH/workspace/$JOB_NAME/conf:/flyway/conf \
          $FLYWAY_IMAGE \
          -configFiles=$FLYWAY_CONFIG \
          -user=$DB_CREDS_USR \
          -password=$DB_CREDS_PSW \
          migrate'''
      }
    }
    stage('validate') {
      steps {
        sh '''docker run --rm \
          --network $FLYWAY_NETWORK \
          -v $JENKINS_HOME_PATH/workspace/$JOB_NAME/sql:/flyway/sql \
          -v $JENKINS_HOME_PATH/workspace/$JOB_NAME/conf:/flyway/conf \
          $FLYWAY_IMAGE \
          -configFiles=$FLYWAY_CONFIG \
          -user=$DB_CREDS_USR \
          -password=$DB_CREDS_PSW \
          validate'''
      }
    }
    stage('info') {
      steps {
        sh '''docker run --rm \
          --network $FLYWAY_NETWORK \
          -v $JENKINS_HOME_PATH/workspace/$JOB_NAME/sql:/flyway/sql \
          -v $JENKINS_HOME_PATH/workspace/$JOB_NAME/conf:/flyway/conf \
          $FLYWAY_IMAGE \
          -configFiles=$FLYWAY_CONFIG \
          -user=$DB_CREDS_USR \
          -password=$DB_CREDS_PSW \
          info'''
      }
    }
  }
}
